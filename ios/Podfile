# Resolve react_native_pods.rb with node to allow for hoisting
source 'https://cdn.cocoapods.org/'
# 26.7.1 SDK pods (mapsted-sdk-map / -map-ui) ship as universal XCFrameworks (device + simulator)
# from the MapstedHQ device spec repo. The old `Mapsted/podspec-simulator` source carried no 26.7.1
# and its simulator-only slice cannot run on a real iPhone. (S14 GATE-0 verified: only MapstedHQ/podspec has 26.7.1.)
source 'https://github.com/MapstedHQ/podspec.git'
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Mapsted SDK 26.7.1 requires iOS 16 (XCFramework deployment_target 16.0); RN 0.76 default is 15.1.
# The Mapsted SDK bridge is a legacy (paper) native module; RN 0.76 defaults the iOS New Architecture ON,
# which makes the legacy `Mapsted` module unreachable (launchMapActivity silently no-ops). Disable New Arch
# on iOS for parity with Android (newArchEnabled=false). Verified: full map render on device w/ this off.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'
platform :ios, '16.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'dempMapstedSampleApp' do
  config = use_native_modules!
  use_frameworks!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'dempMapstedSampleAppTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Resource bundles (e.g. *_privacy, SDWebImage/SSZipArchive resource bundles) must NOT be code-signed;
    # under manual signing / CI archiving they otherwise fail with "requires a development team".
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['PRODUCT_TYPE'] == 'com.apple.product-type.bundle'
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        end
      end
    end
  end
end
